<Window x:Class="WifiSpeedWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speedline" Width="340" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource TextFont}" FontSize="13"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnDrag">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RevealOnHover" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SignalArc" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2.2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource SignalOff}"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="MainMenu">
            <MenuItem x:Name="TestMenuItem" Header="Test now" Click="OnRunTest"/>
            <Separator/>
            <MenuItem x:Name="TopmostItem" Header="Keep on top" IsCheckable="True" Click="OnToggleTopmost"/>
            <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="OnToggleStartup"/>
            <Separator/>
            <MenuItem Header="Clear history" Click="OnClearHistory"/>
            <MenuItem Header="Close widget" Click="OnClose"/>
        </ContextMenu>
    </Window.ContextMenu>

    <StackPanel Margin="20,16,20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0">
                <Viewbox x:Name="WifiIcon">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="Arc3" Style="{StaticResource SignalArc}" Data="M 3.51,9.01 A 12,12 0 0 1 20.49,9.01"/>
                        <Path x:Name="Arc2" Style="{StaticResource SignalArc}" Data="M 6.34,11.84 A 8,8 0 0 1 17.66,11.84"/>
                        <Path x:Name="Arc1" Style="{StaticResource SignalArc}" Data="M 9.17,14.67 A 4,4 0 0 1 14.83,14.67"/>
                        <Ellipse x:Name="Dot" Canvas.Left="10.4" Canvas.Top="15.9" Width="3.2" Height="3.2" Fill="{DynamicResource SignalOff}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="EthernetIcon" Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NetworkName" Text="Connecting…" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="0,2,0,0" Background="Transparent">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextTertiary}"/>
                    <TextBlock x:Name="NetworkDetail" Text="Checking connection" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-4,-8,0" Style="{StaticResource RevealOnHover}">
                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More options" Click="OnMore"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Download" Style="{StaticResource Caption}" Margin="0,22,0,0"/>
        <TextBlock Margin="0,-4,0,0" Typography.NumeralAlignment="Tabular"><Run x:Name="HeroValue" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="48" FontWeight="SemiBold"/><Run Text=" Mbps" FontSize="15" Foreground="{DynamicResource TextSecondary}"/></TextBlock>
        <Border x:Name="ProgressTrack" Height="3" CornerRadius="1.5" Background="{DynamicResource TrackFill}" Margin="0,4,0,8" Opacity="0">
            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5" Background="{DynamicResource Accent}"/>
        </Border>
        <TextBlock x:Name="StatusLine" Text="No tests yet" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Upload" Style="{StaticResource Caption}"/>
                <TextBlock Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"><Run x:Name="UploadValue" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><Run Text=" Mbps" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" ToolTip="Live · measured every 2 seconds">
                <TextBlock Text="Ping" Style="{StaticResource Caption}"/>
                <TextBlock Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"><Run x:Name="PingValue" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><Run Text=" ms" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" ToolTip="How much ping varies between checks">
                <TextBlock Text="Jitter" Style="{StaticResource Caption}"/>
                <TextBlock Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"><Run x:Name="JitterValue" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><Run Text=" ms" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></TextBlock>
            </StackPanel>
        </Grid>

        <Border Height="1" Background="{DynamicResource Divider}" Margin="-20,18,-20,14"/>

        <Grid>
            <TextBlock Text="History" Style="{StaticResource Caption}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                <TextBlock Text="Download" FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,0,12,0"/>
                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource ChartSecondary}" VerticalAlignment="Center" Margin="0,1,5,0"/>
                <TextBlock Text="Upload" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
            </StackPanel>
        </Grid>
        <Grid Height="56" Margin="0,10,0,0">
            <Canvas x:Name="HistoryChart" Background="Transparent" SizeChanged="OnHistorySizeChanged"/>
            <TextBlock x:Name="HistoryEmpty" Text="Results will build up here" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Border Height="1" Background="{DynamicResource Divider}" Margin="-20,14,-20,14"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Typography.NumeralAlignment="Tabular" ToolTip="Network activity on this PC right now"><Run Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiary}"/><Run Text=" "/><Run x:Name="LiveDown" Text="0 Kbps"/><Run Text="     "/><Run Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiary}"/><Run Text=" "/><Run x:Name="LiveUp" Text="0 Kbps"/></TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Button x:Name="ScheduleButton" Style="{StaticResource LinkButton}" Click="OnScheduleClick" ToolTip="How often to test automatically">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ScheduleMenu" Placement="Top">
                                <MenuItem Header="Every 5 minutes" Tag="5" IsCheckable="True" Click="OnAutoInterval"/>
                                <MenuItem Header="Every 15 minutes" Tag="15" IsCheckable="True" Click="OnAutoInterval"/>
                                <MenuItem Header="Every 30 minutes" Tag="30" IsCheckable="True" Click="OnAutoInterval"/>
                                <MenuItem Header="Every hour" Tag="60" IsCheckable="True" Click="OnAutoInterval"/>
                                <Separator/>
                                <MenuItem Header="Off" Tag="0" IsCheckable="True" Click="OnAutoInterval"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock><Run x:Name="ScheduleText" Text="Every 15 min"/><Run Text="  "/><Run Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"/></TextBlock>
                    </Button>
                    <TextBlock x:Name="NextText" Text="" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="RunButton" Grid.Column="1" Style="{StaticResource AccentButton}" Content="Test now" Click="OnRunTest" VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>
